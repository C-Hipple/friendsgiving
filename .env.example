# Copy to .env and fill in. `docker compose up -d` reads it automatically.

# The shared password your friends type to get in. Changing it signs everyone out.
SITE_PASSWORD=

# Host port to expose the site on.
PORT=8080

# Event details. Leave as TBD until they're decided; the site shows "TBD" nicely.
EVENT_NAME=Brogiving 2026
EVENT_DATE=TBD
# e.g. EVENT_DATE=Thursday, November 26
EVENT_TIME=TBD
# e.g. EVENT_TIME=3:00 PM
EVENT_LOCATION=TBD
# e.g. EVENT_LOCATION=Mike's place
EVENT_ADDRESS=
# e.g. EVENT_ADDRESS=123 Harvest Way, Springfield (adds an "Open in Maps" button)

# Timezone for timestamps shown on hover.
TZ=America/New_York
